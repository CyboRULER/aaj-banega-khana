# Copy to .env and fill in. Everything is optional for offline/demo mode.

# --- Roles: WhatsApp numbers (JIDs). Used to tell owner from cook in the group.
ABK_OWNER_JID=911111111111@s.whatsapp.net
ABK_COOK_JID=922222222222@s.whatsapp.net
ABK_GROUP_NAME=
ABK_GROUP_ID=

# --- Timezone for the 08:00 daily plan
ABK_TIMEZONE=Asia/Kolkata
ABK_PLAN_TIME=08:00

# --- LLM provider: auto | anthropic | xai | offline (auto picks by which key is set)
ABK_LLM_PROVIDER=auto

# --- xAI (Grok)
ABK_XAI_API_KEY=
ABK_XAI_BASE_URL=https://api.x.ai/v1
ABK_XAI_MODEL=grok-4.5

# --- Claude (leave empty to use the offline rule-based FakeLLM)
ANTHROPIC_API_KEY=
ABK_PLANNER_MODEL=claude-opus-4-8
ABK_EXTRACTOR_MODEL=claude-sonnet-4-6

# --- Grocery provider: manual | instamart
ABK_GROCERY_PROVIDER=manual
ABK_INSTAMART_MCP_URL=

# --- WhatsApp gateway (Node/Baileys) HTTP endpoint
ABK_GATEWAY_URL=http://localhost:8787

# --- Storage
ABK_DB_PATH=data/abk.sqlite3
ABK_RECIPE_DIR=recipes
